# Règles Apache (o2switch) pour shoptonchargeur.bsandoz.fr, envoyées avec le site.

RewriteEngine On

# Ancienne adresse (choptonchargeur.bsandoz.fr, même dossier) : redirection définitive vers la nouvelle,
# même page, pour garder les visiteurs, les liens partagés et le référencement Google.
RewriteCond %{HTTP_HOST} ^(www\.)?choptonchargeur\.bsandoz\.fr$ [NC]
RewriteRule ^ https://shoptonchargeur.bsandoz.fr%{REQUEST_URI} [L,R=301]

# Toujours en HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Adresses de pages sans fichier généré (ex. un téléphone du catalogue) : l'application les affiche.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Fichiers versionnés (nom avec empreinte) : gardés un an ; la page, jamais en cache (elle pointe vers les nouveaux fichiers).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Fichiers texte compressés.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
